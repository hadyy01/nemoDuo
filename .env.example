# ─────────────────────────────────────────
# NemoDuo Configuration
# Copy this file to .env and fill in values
# ─────────────────────────────────────────

# NVIDIA NIM API (for Nemotron 3 Super - Planner)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Planner model (Nemotron 3 Super via NIM)
PLANNER_MODEL=nvidia/nemotron-3-super-120b-a12b

# Executor model (Nemotron 3 Nano 4B via Ollama locally)
EXECUTOR_MODEL=nemotron3-nano-4b
OLLAMA_BASE_URL=http://localhost:11434

# Reasoning budget (tokens) — dial up for accuracy, down for speed
# Recommended: 512 (fast) | 2048 (balanced) | 8192 (deep)
REASONING_BUDGET=2048

# Web search (uses DuckDuckGo by default — no key needed)
# Optionally use Serper for better results
SERPER_API_KEY=

# Max subtasks Nano will execute per query
MAX_SUBTASKS=5

# Max tokens per agent response
MAX_TOKENS=1024

# SQLite DB path for metrics logging
METRICS_DB_PATH=./data/metrics.db
